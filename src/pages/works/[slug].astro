---
import Layout from "../../layouts/Layout_works.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const works = await getCollection("works");

  return works.map((work) => ({
    params: { slug: work.slug },
    props: { work },
  }));
}

const { work } = Astro.props;
const base = import.meta.env.BASE_URL;
const galleryCount = work.data.gallery?.length || 0;
const youtubeCount = work.data.youtube?.length || 0;
---

<Layout>
	<main>
		<div class="wrap">				
			<h3 class="title">{work.data.title}</h3>
			
			<p class="period">
				{work.data.startDate.toLocaleDateString("ja-JP")}
				{work.data.endDate && (
					<>
			{" - "}
			{work.data.endDate.toLocaleDateString("ja-JP")}
			</>
			)}
			</p>

			<p class="categories">{work.data.categories?.join(' / ')}</p>
			<div class="tags">
				{work.data.tags?.map((tag) => (
					<span>{tag}</span>
				))}
			</div>

			<div class="spacer"></div>
			
			<div class:list={[
				{ 'youtube00': youtubeCount === 0 },
				{ 'youtube01': youtubeCount === 1 },
				{ 'youtube02': youtubeCount === 2 }
				]}>
				{work.data.youtube?.map((id) => (
				<div class="video">
					<iframe
					src={`https://www.youtube.com/embed/${id}`}
					title="YouTube video"
					allowfullscreen>
					</iframe>
				</div>
				))}
			</div>
			
			<div class="spacer" class:list={[{ 'youtube00': youtubeCount === 0 }]}></div>
			
			<div class:list={[
				{ 'gallery00': galleryCount === 0 },
				{ 'gallery01': galleryCount === 1 },
				{ 'gallery02': galleryCount === 2 },
				{ 'gallery03': galleryCount === 3 },
				{ 'gallery04': galleryCount === 4 },
				{ 'gallery05': galleryCount === 5 },
				{ 'gallery06': galleryCount === 6 },
				{ 'gallery07': galleryCount === 7 },
				{ 'gallery08': galleryCount === 8 }
			]}>
				{work.data.gallery?.map((img) => (
					<div class="gallery">
						<img style="display: block; width: 100%;" src={`${base}${img}`} />
					</div>
				))}
			</div>

			<div class="spacer" class:list={[{ 'gallery00': galleryCount === 0 }]}></div>

			{work.data.detail && (
			<section class="work-section">
				<div class="detail">
					<p>{work.data.detail}</p>
				</div>
			</section>
			)}
			
			{work.data.improvements && (
			<section class="work-section">
				<h4 class="improvements">工夫点</h4>
				<ul>
				{work.data.improvements.map((item) => (
					<li>{item}</li>
				))}
				</ul>
			</section>
			)}

			{work.data.challenges && (
			<section class="work-section">
				<h4 class="challenges">課題点</h4>
				<ul>
				{work.data.challenges.map((item) => (
					<li>{item}</li>
				))}
				</ul>
			</section>
			)}

			<div class="reverse_allworks">
				<a href={`${base}works/`}>◀︎ 作品一覧</a>
			</div>
		</div>
	</main>

	<style>
		.spacer {
			display: block;
			height: 50px;
		}
		.youtube00,
		.gallery00 {
			display: none;
		}

		.wrap {
			margin: 180px auto 100px;
			width: calc((1000 / 1440)*100%);
			max-width: 1000px;
		}

		h3.title {
			margin-bottom: 20px;
			font-size: min(50px, calc((50 / 1440)*100vw));
			font-weight: 400;
			letter-spacing: .1em;
		}
		.period {
			margin-bottom: 50px;
			font-size: min(25px, calc((25 / 1440)*100vw));
			font-weight: 300;
			letter-spacing: .1em;
			text-align: right;
		}
		.tags,
		.categories {
			display: flex;
			gap: 10px;
			margin-bottom: 10px;
			padding-left: 20px;
			position: relative;
			font-size: min(25px, calc((25 / 1440)*100vw));
			font-weight: 300;
			letter-spacing: .1em;
		}
		.tags::before,
		.categories::before {
			content: '';
			display: block;
			width: 8px;
			height: 8px;
			position: absolute;
			top: 50%;
			left: 0;
			transform: translateY(calc(-50% + 2px));
			background-color: #c9970d;
			/* filter: blur(2px); */
			transition: 0.8s ease-in-out;
		}
		.categories::before {
			background-color: #092e45;
		}
		.thumbnail img {
			width: 100%;
		}
		.video {
			position: relative;
			padding-bottom: 56.25%;
			height: 0;
		}
		.video iframe {
			position: absolute;
			margin: 0 auto;
			width: calc((950 / 1000)*100%);
			max-width: 950px;
			height: 100%;
			left: 50%;
			top: 0;
			transform: translateX(-50%);
		}
		.youtube02 {
			display: grid;
			grid-template-columns: 1fr 1fr;
			width: 100%;
		}
		.youtube02 .video iframe {
			width: 95%;
		}
		.gallery {
			width: calc((500/1000)*100%);
			margin: 0 auto;
		}
		.gallery04 {
			display: grid;
			grid-template-columns: 1fr 1fr;
			grid-template-rows: 1fr 1fr;
			gap: 30px;
			width: 100%;
			margin: 0 auto;
		}
		.gallery04 .gallery {
			width: 100%;
			margin: 0 auto;
		}
		.work-section {
			margin-bottom: 50px;
		}
		.work-section ul {
			padding-left: 20px;
		}
		.detail {
			margin: 50px 0 0;
		}
		h4.improvements,
		h4.challenges {
			margin-bottom: 10px;
			padding-left: 15px;
			position: relative;
			font-size: min(20px, calc((20 / 1440)*100vw));
			font-weight: 300;
			letter-spacing: .1em;
		}
		h4.improvements::before,
		h4.challenges::before {
			content: '';
			display: block;
			width: 5px;
			height: 5px;
			position: absolute;
			top: 50%;
			left: 0;
			transform: translateY(calc(-50% + 1px));
			background-color: #c90d0d;
			transition: 0.8s ease-in-out;
		}
		h4.challenges::before {
			background-color: #2853be;
		}
		.reverse_allworks {
			margin: 150px 0;
		}
		.reverse_allworks a {
			font-size: min(20px, calc((20 / 1440)*100vw));
			font-weight: 300;
			letter-spacing: .1em;
			color: #000;
			text-decoration: none;
		}

		@media screen and (max-width: 768px) {
			.wrap {
				margin-top: 100px;
				width: calc((650 / 768)*100%);
			}

			.spacer {
				display: block;
				height: 20px;
			}

			h3.title {
				margin-bottom: 20px;
				font-size: min(50px, calc((50 / 768)*100vw));
				letter-spacing: .05em;
			}
			.period {
				margin-bottom: 50px;
				font-size: min(30px, calc((30 / 768)*100vw));
				font-weight: 400;
			}
			.tags,
			.categories {
				margin-bottom: 5px;
				padding-left: 12px;
				font-size: min(25px, calc((25 / 768)*100vw));
				font-weight: 400;
			}
			.tags::before,
			.categories::before {
				width: 5px;
				height: 5px;
			}
			.work-section {
				margin-bottom: 50px;
			}
			.youtube02 {
				display: flex;
				flex-direction: column;
			}
			.youtube02 .video iframe {
				width: 95%;
			}
			.reverse_allworks {
				margin: 0;
			}
			.reverse_allworks a {
				font-size: min(20px, calc((20 / 768)*100vw));
			}
		}
	</style>

</Layout>