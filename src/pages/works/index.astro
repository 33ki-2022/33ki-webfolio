---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const works = await getCollection("works");
const base = import.meta.env.BASE_URL;

// 新しい順に並べ替え
works.sort(
    (a, b) => b.data.startDate.getTime() - a.data.startDate.getTime()
);
---

<Layout>
  <section class="works">
    <div class="works__inner">
        <h2>Works</h2>
        <div class="filter">
            <button data-filter="all">ALL</button>
            <button data-filter="Movie">Movie</button>
            <button data-filter="Web">Web</button>
            <button data-filter="Design">Design</button>
            <button data-filter="Exhibit">Exhibit</button>
            <button data-filter="3DCG">3DCG</button>
            <button data-filter="Other">Other</button>
        </div>
        <div class="works-grid">
        {works.map((post) => (
            <a href={`${import.meta.env.BASE_URL}works/${post.slug}/`} class="card" data-category={`${post.data.categories?.join(',')}`}>
            <img src={`${base}${post.data.thumbnail}`} alt={post.data.title} />

            <div class="card-body">
                <p class="period">
                    {post.data.startDate.toLocaleDateString("ja-JP")}
                    {post.data.endDate && (
                        <>
                        {" - "}
                        {post.data.endDate.toLocaleDateString("ja-JP")}
                        </>
                    )}
                </p>

                <h3 class="card__text">{post.data.title}</h3>
                <p class="categories">{post.data.categories?.join(' / ')}</p>
                <div class="tags">
                {post.data.tags?.map((tag) => (
                    <span class="tag">{tag}</span>
                ))}
                </div>

                {post.data.description && (
                <p class="description">
                    {post.data.description}
                </p>
                )}
            </div>
            </a>
        ))}
        </div>
    </div>
  </section>

  <style>
    h2 {
        font-size: min(32px, calc((32 / 1440)*100vw));
        font-weight: 300;
        letter-spacing: .3em;
    }
    .works {
      background-color: #dfecf6;
    }
    .works__inner {
      margin: 0 auto;
      padding: 100px 20px;
      width: calc((1200 / 1440)*100%);
      max-width: 1200px;

    }
    .filter {
        display: flex;
        gap: 15px;
    }
    .filter button {
        padding: 15px 30px;
        border: none;
        border-radius: 100px;
        color: #fff;
        background-color: #586AA8;
    }
    .filter button:hover {
        background-color: #c9970d;
    }
    .works-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 40px;
      margin-top: 40px;
    }

    .card {
      text-decoration: none;
      color: inherit;
      overflow: hidden;
      background: #fff;
      transition: 0.3s ease;
    }
    .card.hide {
    display: none;
        transform: scale(0.95);
        pointer-events: none;
    }

    .card:hover {
      transform: scale(103%);
    }

    .card img {
      width: 100%;
      height: 240px;
      object-fit: cover;
    }
    .card-body {
      padding: 24px;
    }
    .period {
      font-size: 12px;
      letter-spacing: .1em;
      margin-bottom: 6px;
    }    
    h3.card__text {
		margin-bottom: 5px;
		font-size: min(20px, calc((20 / 1440)*100vw));
		font-weight: 400;
		letter-spacing: .1em;
	}
  .tags,
	.categories {
    display: flex;
		gap: 10px;
		padding-left: 20px;
		position: relative;
		font-size: min(15px, calc((15 / 1440)*100vw));
		font-weight: 300;
		letter-spacing: .1em;
	}
	.tags::before,
	.categories::before {
    content: '';
		display: block;
		width: 5px;
		height: 5px;
		position: absolute;
		top: 50%;
		left: 0;
    transform: translateY(-50%);
		background-color: #c9970d;
		filter: blur(2px);
	}
	.categories::before {
        background-color: #586AA8;
	}
    .description {
      font-size: 14px;
      margin: 12px 0;
      line-height: 1.6;
    }

@media screen and (max-width: 768px) {
  h2 {
    font-size: min(32px, calc((32 / 768)*100vw));
    margin-bottom: 30px;
  }
  .filter {
    flex-wrap: wrap;
  }
  .filter button {
    padding: 10px 20px;
  }
  .works__inner {
    padding: 100px 0;
  }
  h3.card__text {
    margin-bottom: 5px;
    font-size: min(35px, calc((35 / 768) * 100vw));
  }
  .tags,
	.categories {
		gap: 5px;
		padding-left: 15px;
		font-size: min(20px, calc((20 / 768)*100vw));
	}
	.tags::before,
	.categories::before {
		width: 3px;
		height: 3px;
	}
}
    </style>

</Layout>

<script is:inline>
    console.log("JS動いてる");

  const buttons = document.querySelectorAll('.filter button');
  const cards = document.querySelectorAll('.card');

  buttons.forEach(button => {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter;

      cards.forEach(card => {
        const categories = card.dataset.category
          .split(',')
          .map(c => c.trim());

        if (filter === 'all' || categories.includes(filter)) {
          card.classList.remove('hide');
        } else {
          card.classList.add('hide');
        }
      });
    });
  });
</script>
